# Supabase - get these from your project settings at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: a relay (TURN) server for voice chat, only needed if some players
# cannot connect because their network blocks direct calls.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-server:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
